{
  "name": "@rivet/pr-reader-webview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "format": "biome format --write --no-errors-on-unmatched .",
    "format:check": "biome format --no-errors-on-unmatched .",
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "../../scripts/check-renderer-types.sh",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "typescript": "~6.0.0"
  },
  "dependencies": {
    "diff2html": "^3.4.56"
  }
}
