{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "模型 C：401 憑證更新與重試（採用目標架構／尚未實作）",
    "quality_profile": "showcase",
    "viewBox": [1250, 720],
    "column_fit": "spread",
    "legend": { "mode": "hidden" },
    "views": [
      {
        "id": "original-request-context",
        "label": "原始請求脈絡",
        "focus": ["caller", "auth-requester"],
        "note": "呼叫端是原始 HTTPRequest 提供者；AuthRequester 是原始請求唯一所有者與語意解讀者。"
      },
      {
        "id": "flow-context",
        "label": "流程脈絡",
        "focus": ["auth", "auth-flow"],
        "note": "Auth 是每次執行建立 AuthFlow 的工廠；AuthFlow 保有每次執行的 401 策略／狀態。"
      },
      {
        "id": "io-boundary-context",
        "label": "I/O 邊界脈絡",
        "focus": ["requester", "refresh-boundary"],
        "note": "Requester 擁有通用 HTTP 輸入／輸出；待定憑證更新邊界僅限後續具體消費端。"
      }
    ]
  },
  "participants": [
    { "id": "caller", "type": "external", "label": "呼叫端" },
    { "id": "auth-requester", "type": "backend", "label": "AuthRequester" },
    { "id": "auth", "type": "security", "label": "Auth" },
    { "id": "auth-flow", "type": "security", "label": "AuthFlow" },
    { "id": "requester", "type": "backend", "label": "Requester" },
    { "id": "refresh-boundary", "type": "external", "label": "待定的憑證更新邊界" }
  ],
  "segments": [
    { "from": 150, "to": 240, "label": "呼叫端入口與每次執行的流程建立" },
    { "from": 246, "to": 448, "label": "首次 401 的唯一策略所有者" },
    { "from": 454, "to": 654, "label": "只在更新成功後的一次重試與終態回傳" }
  ],
  "messages": [
    { "id": "caller-entry", "from": "caller", "to": "auth-requester", "y": 160, "label": "交付原始 HTTPRequest（本次執行入口）", "variant": "emphasis" },
    { "id": "request-flow", "from": "auth-requester", "to": "auth", "y": 188, "label": "要求建立本次執行的 AuthFlow（無原始請求資料）", "variant": "security" },
    { "id": "return-flow", "from": "auth", "to": "auth-requester", "y": 216, "label": "回傳新的 AuthFlow（僅流程執行個體）", "variant": "return" },
    { "id": "initial-decision-input", "from": "auth-requester", "to": "auth-flow", "y": 244, "label": "請求初始語意（無請求資料）", "variant": "security" },
    { "id": "initial-send", "from": "auth-flow", "to": "auth-requester", "y": 272, "label": "初始傳送語意（無請求資料）", "variant": "return" },
    { "id": "initial-execution", "from": "auth-requester", "to": "requester", "y": 300, "label": "執行保留的原始請求", "variant": "default" },
    { "id": "first-401", "from": "requester", "to": "auth-requester", "y": 328, "label": "原始 HTTPResponse：401", "variant": "return" },
    { "id": "flow-receives-401", "from": "auth-requester", "to": "auth-flow", "y": 356, "label": "轉交 401 回應語意", "variant": "security" },
    { "id": "refresh-decision", "from": "auth-flow", "to": "auth-requester", "y": 384, "label": "僅符合資格的 AuthFlow：更新；不具資格則終態", "variant": "return" },
    { "id": "dispatch-refresh", "from": "auth-requester", "to": "refresh-boundary", "y": 412, "label": "派送待定的憑證更新", "variant": "dashed" },
    { "id": "refresh-complete", "from": "refresh-boundary", "to": "auth-requester", "y": 440, "label": "更新結果（合約延後確定）", "variant": "return" },
    { "id": "refresh-outcome", "from": "auth-requester", "to": "auth-flow", "y": 468, "label": "經延後確定的結果邊界交回流程", "variant": "security" },
    { "id": "retry-permission", "from": "auth-flow", "to": "auth-requester", "y": 496, "label": "只有更新成功：一次重試；失敗終態", "variant": "return" },
    { "id": "retry-original", "from": "auth-requester", "to": "requester", "y": 524, "label": "僅重送原始請求", "variant": "emphasis" },
    { "id": "retry-response", "from": "requester", "to": "auth-requester", "y": 552, "label": "原始 HTTPResponse", "variant": "return" },
    { "id": "terminal-input", "from": "auth-requester", "to": "auth-flow", "y": 580, "label": "轉交重試回應語意", "variant": "security" },
    { "id": "terminal-decision", "from": "auth-flow", "to": "auth-requester", "y": 608, "label": "終態決策：正常回應完成；第二次 401 不再更新，由 AuthRequester 回傳", "variant": "return" },
    { "id": "terminal-return", "from": "auth-requester", "to": "caller", "y": 636, "label": "回傳最終 HTTPResponse", "variant": "return" }
  ],
  "activations": [
    { "participant": "caller", "from": 154, "to": 642, "type": "external" },
    { "participant": "auth-requester", "from": 156, "to": 642, "type": "backend" },
    { "participant": "auth", "from": 182, "to": 222, "type": "security" },
    { "participant": "auth-flow", "from": 238, "to": 614, "type": "security" },
    { "participant": "requester", "from": 294, "to": 334, "type": "backend" },
    { "participant": "requester", "from": 518, "to": 558, "type": "backend" },
    { "participant": "refresh-boundary", "from": 406, "to": 446, "type": "external" }
  ]
}
