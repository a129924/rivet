{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "AuthFlow 狀態生命週期（採用目標架構／尚未實作）",
    "quality_profile": "showcase",
    "viewBox": [980, 660],
    "legend": { "mode": "hidden" }
  },
  "lanes": [
    { "id": "main", "label": "正常策略路徑" },
    { "id": "recovery", "label": "401 復原策略" },
    { "id": "terminal", "label": "終態結果" }
  ],
  "states": [
    { "id": "flow-created", "type": "start", "label": "獨立流程", "sublabel": "工廠 API 尚未鎖定", "lane": "main", "col": 0, "step": "01", "tag": "目標架構入口" },
    { "id": "initial-decision", "type": "active", "label": "初始決策", "sublabel": "傳送語意", "lane": "main", "col": 1, "step": "02", "tag": "不建構請求" },
    { "id": "waiting-response", "type": "waiting", "label": "等待原始回應", "sublabel": "輸入／輸出不在流程內", "lane": "main", "col": 2, "step": "03", "tag": "回應輸入" },
    { "id": "response-policy", "type": "decision", "label": "回應策略", "sublabel": "正常回應或首次 401", "lane": "main", "col": 3, "step": "04", "tag": "流程所有者" },
    { "id": "terminal-response", "type": "success", "label": "終態回應", "sublabel": "回傳正常／重試成功結果", "lane": "main", "col": 4, "step": "05", "tag": "終態" },
    { "id": "first-401", "type": "decision", "label": "首次 401", "sublabel": "唯一憑證更新決策所有者", "lane": "recovery", "col": 0, "tag": "策略" },
    { "id": "refresh-boundary", "type": "external", "label": "待定的憑證更新", "sublabel": "非現行執行期 API", "lane": "recovery", "col": 1, "tag": "未來機制" },
    { "id": "retry-permission", "type": "active", "label": "一次重試許可", "sublabel": "僅保留的原始請求", "lane": "recovery", "col": 2, "tag": "策略" },
    { "id": "refresh-failed", "type": "failure", "label": "憑證更新失敗", "sublabel": "終態", "lane": "terminal", "col": 1, "tag": "終態" },
    { "id": "second-401", "type": "failure", "label": "第二次 401", "sublabel": "終態；不再更新", "lane": "terminal", "col": 2, "tag": "終態" }
  ],
  "transitions": [
    { "id": "create-flow", "from": "flow-created", "to": "initial-decision" },
    { "id": "initial-send", "from": "initial-decision", "to": "waiting-response" },
    { "id": "receive-response", "from": "waiting-response", "to": "response-policy" },
    { "id": "normal-terminal", "from": "response-policy", "to": "terminal-response" },
    { "id": "first-401-decision", "from": "response-policy", "to": "first-401", "variant": "security", "fromSide": "bottom", "toSide": "top", "via": [[556, 240], [402, 240]] },
    { "id": "dispatch-refresh", "from": "first-401", "to": "refresh-boundary", "variant": "security", "fromSide": "bottom", "toSide": "bottom", "via": [[402, 370], [556, 370]] },
    { "id": "refresh-failure", "from": "refresh-boundary", "to": "refresh-failed", "variant": "security", "route": "bottom-channel" },
    { "id": "refresh-success", "from": "refresh-boundary", "to": "retry-permission", "variant": "emphasis", "fromSide": "bottom", "toSide": "bottom", "via": [[556, 400], [710, 400]] },
    { "id": "retry-success", "from": "retry-permission", "to": "terminal-response", "variant": "emphasis", "route": "top-channel" },
    { "id": "second-401-terminal", "from": "retry-permission", "to": "second-401", "variant": "security", "route": "bottom-channel" }
  ]
}
