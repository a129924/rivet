{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "AuthFlow 狀態生命週期（採用目標架構／尚未實作）",
    "quality_profile": "showcase",
    "viewBox": [980, 660],
    "legend": { "mode": "hidden" }
  },
  "lanes": [
    { "id": "main", "label": "正常策略路徑" },
    { "id": "recovery", "label": "401 復原策略" },
    { "id": "terminal", "label": "終態結果" }
  ],
  "states": [
    { "id": "flow-created", "type": "start", "label": "Auth 建立流程", "sublabel": "每次執行；初始語意前", "lane": "main", "col": 0, "step": "01", "tag": "目標架構入口" },
    { "id": "initial-decision", "type": "active", "label": "初始決策", "sublabel": "傳送語意；無請求資料", "lane": "main", "col": 1, "step": "02", "tag": "不建構請求" },
    { "id": "waiting-response", "type": "waiting", "label": "等待原始／重試回應", "sublabel": "AuthRequester 交付回應", "lane": "main", "col": 2, "step": "03", "tag": "回應輸入" },
    { "id": "response-policy", "type": "decision", "label": "回應策略", "sublabel": "初始／重試 HTTPResponse／更新結果的流程狀態判斷", "lane": "main", "col": 3, "width": 190, "yOffset": 74, "step": "04", "tag": "流程所有者" },
    { "id": "terminal-response", "type": "success", "label": "終態回應", "sublabel": "回傳正常／重試成功結果", "lane": "main", "col": 4, "step": "05", "tag": "終態" },
    { "id": "first-401", "type": "decision", "label": "首次 401", "sublabel": "具資格才可要求更新", "lane": "recovery", "col": 0, "yOffset": 82, "tag": "策略" },
    { "id": "refresh-boundary", "type": "external", "label": "待定的憑證更新", "sublabel": "經延後確定的邊界", "lane": "recovery", "col": 1, "yOffset": 82, "tag": "未來機制" },
    { "id": "waiting-for-retry-response", "type": "waiting", "label": "等待重試回應", "sublabel": "重送後交付回應", "lane": "recovery", "col": 2, "yOffset": 82, "tag": "回應輸入" },
    { "id": "ineligible-401", "type": "failure", "label": "不具資格的 401", "sublabel": "終態；不要求更新", "lane": "terminal", "col": 0, "tag": "終態" },
    { "id": "refresh-failed", "type": "failure", "label": "憑證更新失敗", "sublabel": "終態；不可重試", "lane": "terminal", "col": 1, "tag": "終態" },
    { "id": "second-401", "type": "failure", "label": "第二次 401", "sublabel": "終態；不再更新", "lane": "terminal", "col": 2, "tag": "終態" }
  ],
  "transitions": [
    { "id": "create-flow", "from": "flow-created", "to": "initial-decision" },
    { "id": "initial-send", "from": "initial-decision", "to": "waiting-response" },
    { "id": "receive-response", "from": "waiting-response", "to": "response-policy", "fromSide": "bottom", "toSide": "left", "via": [[402, 210], [440, 210], [440, 231]] },
    { "id": "normal-terminal", "from": "response-policy", "to": "terminal-response", "route": "top-channel", "fromSide": "top", "toSide": "top", "channelY": 96 },
    { "id": "first-401-decision", "from": "response-policy", "to": "first-401", "label": "初始回應為 401：資格判斷", "variant": "security", "fromSide": "left", "toSide": "top", "via": [[440, 231], [440, 320], [402, 320]], "labelAt": [420, 340] },
    { "id": "dispatch-refresh", "from": "first-401", "to": "refresh-boundary", "label": "具資格的更新語意", "variant": "security", "fromSide": "bottom", "toSide": "bottom", "via": [[402, 434], [556, 434]], "labelAt": [540, 446] },
    { "id": "ineligible-terminal", "from": "first-401", "to": "ineligible-401", "label": "不具資格／不具更新能力", "variant": "security", "route": "straight", "labelAt": [250, 440] },
    { "id": "refresh-result", "from": "refresh-boundary", "to": "response-policy", "label": "更新結果交回 AuthFlow 策略", "variant": "security", "route": "straight", "fromSide": "top", "toSide": "bottom", "labelAt": [365, 290] },
    { "id": "refresh-failure", "from": "response-policy", "to": "refresh-failed", "label": "更新失敗：終態", "variant": "security", "fromSide": "left", "toSide": "left", "via": [[440, 231], [440, 300], [320, 300], [320, 542], [480, 542], [480, 479]], "labelAt": [250, 410] },
    { "id": "refresh-success", "from": "response-policy", "to": "waiting-for-retry-response", "label": "更新成功：一次重試許可", "variant": "emphasis", "fromSide": "right", "toSide": "right", "via": [[790, 231], [790, 389]], "labelAt": [820, 290] },
    { "id": "retry-response-policy", "from": "waiting-for-retry-response", "to": "response-policy", "variant": "emphasis", "fromSide": "left", "toSide": "top", "via": [[630, 389], [630, 170], [556, 170]] },
    { "id": "second-401-terminal", "from": "response-policy", "to": "second-401", "variant": "security", "fromSide": "bottom", "toSide": "right", "via": [[556, 320], [850, 320], [850, 479]] }
  ]
}
