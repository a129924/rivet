{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "RivetHTTPClient AuthFlow 目標合約生命週期",
    "quality_profile": "showcase",
    "viewBox": [1040, 640],
    "legend": { "mode": "hidden" }
  },
  "lanes": [
    { "id": "main", "label": "採用目標架構（尚未實作）" },
    { "id": "response", "label": "回應輸入與語意決策" },
    { "id": "terminal", "label": "終態與待定邊界" }
  ],
  "states": [
    {
      "id": "make-flow",
      "type": "start",
      "label": "獨立流程",
      "sublabel": "工廠 API 尚未鎖定",
      "lane": "main",
      "col": 0,
      "width": 110,
      "step": "01",
      "tag": "目標架構入口"
    },
    {
      "id": "auth-flow",
      "type": "active",
      "label": "AuthFlow",
      "sublabel": "策略／狀態所有者",
      "lane": "main",
      "col": 1,
      "width": 110,
      "step": "02",
      "tag": "目標合約"
    },
    {
      "id": "start",
      "type": "decision",
      "label": "初始決策",
      "sublabel": "僅語意決策",
      "lane": "main",
      "col": 2,
      "width": 115,
      "step": "03",
      "tag": "不建構請求"
    },
    {
      "id": "initial-send",
      "type": "active",
      "label": "AuthRequester",
      "sublabel": "原始請求唯一所有者",
      "lane": "main",
      "col": 3,
      "width": 118,
      "step": "04",
      "tag": "目標所有者"
    },
    {
      "id": "client-send",
      "type": "active",
      "label": "Requester",
      "sublabel": "通用 HTTP 輸入／輸出",
      "lane": "main",
      "col": 4,
      "width": 118,
      "step": "05",
      "tag": "目標所有者"
    },
    {
      "id": "response",
      "type": "active",
      "label": "原始 HTTPResponse",
      "sublabel": "轉交給流程",
      "lane": "response",
      "col": 2,
      "width": 125,
      "yOffset": -40,
      "tag": "回應"
    },
    {
      "id": "receive",
      "type": "decision",
      "label": "回應策略",
      "sublabel": "結束／更新／重試",
      "lane": "response",
      "col": 1,
      "width": 130,
      "yOffset": 30,
      "tag": "僅限 AuthFlow"
    },
    {
      "id": "resend",
      "type": "active",
      "label": "僅重試原始請求",
      "sublabel": "不可任意建構請求",
      "lane": "response",
      "col": 1,
      "width": 130,
      "yOffset": 120,
      "tag": "目標限制"
    },
    {
      "id": "start-finish",
      "type": "failure",
      "label": "待定的憑證更新",
      "sublabel": "僅限後續主題",
      "lane": "terminal",
      "col": 0,
      "width": 110,
      "tag": "未命名／未實作"
    },
    {
      "id": "receive-finish",
      "type": "success",
      "label": "終態回應",
      "sublabel": "由 AuthRequester 回傳",
      "lane": "terminal",
      "col": 2,
      "width": 110,
      "tag": "目標結果"
    },
    {
      "id": "requester-failure",
      "type": "failure",
      "label": "既有模型 A",
      "sublabel": ".send(HTTPRequest)；非目標",
      "lane": "terminal",
      "col": 2,
      "width": 130,
      "yOffset": -140,
      "tag": "歷史可追溯性"
    }
  ],
  "transitions": [
    { "id": "creates", "from": "make-flow", "to": "auth-flow" },
    { "id": "starts", "from": "auth-flow", "to": "start" },
    {
      "id": "start-send",
      "from": "start",
      "to": "initial-send",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "refresh-decision",
      "from": "receive",
      "to": "start-finish",
      "route": "left-channel"
    },
    {
      "id": "client-sends-initial-request",
      "from": "initial-send",
      "to": "client-send"
    },
    {
      "id": "client-receives-response",
      "from": "client-send",
      "to": "response"
    },
    {
      "id": "receives-response",
      "from": "response",
      "to": "receive"
    },
    {
      "id": "terminal-decision",
      "from": "receive",
      "to": "receive-finish",
      "route": "bottom-channel",
      "fromSide": "left",
      "toSide": "bottom",
      "via": [[480, 337], [480, 540], [710, 540]]
    },
    { "id": "retry-decision", "from": "receive", "to": "resend" },
    {
      "id": "client-sends-retry",
      "from": "resend",
      "to": "client-send",
      "route": "right-channel",
      "fromSide": "right",
      "toSide": "right"
    }
  ]
}
