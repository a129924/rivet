{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "RivetHTTPClient AuthFlow 目標合約生命週期",
    "quality_profile": "showcase",
    "viewBox": [1040, 640],
    "legend": { "mode": "hidden" }
  },
  "lanes": [
    { "id": "main", "label": "採用目標架構（尚未實作）" },
    { "id": "response", "label": "回應輸入與語意決策" },
    { "id": "terminal", "label": "終態與待定邊界" }
  ],
  "states": [
    {
      "id": "make-flow",
      "type": "start",
      "label": "Auth 建立流程",
      "sublabel": "每次執行；初始語意前",
      "lane": "main",
      "col": 0,
      "width": 110,
      "step": "01",
      "tag": "目標架構入口"
    },
    {
      "id": "auth-flow",
      "type": "active",
      "label": "AuthFlow",
      "sublabel": "策略／狀態所有者",
      "lane": "main",
      "col": 1,
      "width": 110,
      "step": "02",
      "tag": "目標合約"
    },
    {
      "id": "start",
      "type": "decision",
      "label": "初始語意決策",
      "sublabel": "無請求資料",
      "lane": "main",
      "col": 2,
      "width": 115,
      "step": "03",
      "tag": "不建構請求"
    },
    {
      "id": "initial-send",
      "type": "active",
      "label": "AuthRequester",
      "sublabel": "只保有呼叫端原始請求",
      "lane": "main",
      "col": 3,
      "width": 118,
      "step": "04",
      "tag": "目標所有者"
    },
    {
      "id": "client-send",
      "type": "active",
      "label": "Requester",
      "sublabel": "通用 HTTP 輸入／輸出",
      "lane": "main",
      "col": 4,
      "width": 118,
      "step": "05",
      "tag": "目標所有者"
    },
    {
      "id": "response",
      "type": "active",
      "label": "原始 HTTPResponse",
      "sublabel": "由 AuthRequester 轉交流程",
      "lane": "response",
      "col": 2,
      "width": 125,
      "yOffset": -40,
      "tag": "回應"
    },
    {
      "id": "receive",
      "type": "decision",
      "label": "回應策略",
      "sublabel": "正常回應／首次 401／更新結果",
      "lane": "response",
      "col": 1,
      "width": 130,
      "yOffset": 30,
      "tag": "僅限 AuthFlow"
    },
    {
      "id": "resend",
      "type": "active",
      "label": "一次重試決策",
      "sublabel": "僅更新成功後",
      "lane": "response",
      "col": 1,
      "width": 130,
      "yOffset": 120,
      "tag": "目標限制"
    },
    {
      "id": "start-finish",
      "type": "external",
      "label": "待定的憑證更新",
      "sublabel": "更新結果待回傳流程",
      "lane": "terminal",
      "col": 0,
      "width": 110,
      "tag": "未命名／未實作"
    },
    {
      "id": "receive-finish",
      "type": "neutral",
      "label": "終態回應",
      "sublabel": "流程終態",
      "lane": "terminal",
      "col": 2,
      "width": 140,
      "tag": "正常／不具資格／第二次 401／更新失敗"
    },
    {
      "id": "requester-failure",
      "type": "failure",
      "label": "既有模型 A",
      "sublabel": ".send(HTTPRequest)；非目標",
      "lane": "terminal",
      "col": 2,
      "width": 130,
      "yOffset": -140,
      "tag": "歷史可追溯性"
    }
  ],
  "transitions": [
    { "id": "creates", "from": "make-flow", "to": "auth-flow" },
    { "id": "starts", "from": "auth-flow", "to": "start" },
    {
      "id": "start-send",
      "from": "start",
      "to": "initial-send",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "refresh-decision",
      "from": "receive",
      "to": "start-finish",
      "route": "left-channel",
      "label": "首次 401：具資格才可更新",
      "variant": "security"
    },
    {
      "id": "client-sends-initial-request",
      "from": "initial-send",
      "to": "client-send"
    },
    {
      "id": "client-receives-response",
      "from": "client-send",
      "to": "response"
    },
    {
      "id": "receives-response",
      "from": "response",
      "to": "receive"
    },
    {
      "id": "terminal-decision",
      "from": "receive",
      "to": "receive-finish",
      "route": "bottom-channel",
      "fromSide": "left",
      "toSide": "bottom",
      "via": [[480, 337], [480, 540], [710, 540]]
    },
    {
      "id": "refresh-success-result",
      "from": "start-finish",
      "to": "receive",
      "label": "更新結果經 AuthRequester 回到流程",
      "variant": "emphasis",
      "fromSide": "left",
      "toSide": "top",
      "via": [[220, 479], [220, 220], [556, 220]],
      "labelAt": [430, 210]
    },
    {
      "id": "refresh-failure-terminal",
      "from": "receive",
      "to": "resend",
      "label": "更新成功：允許一次重試",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelAt": [556, 380]
    },
    {
      "id": "client-sends-retry",
      "from": "resend",
      "to": "client-send",
      "route": "right-channel",
      "fromSide": "right",
      "toSide": "right"
    }
  ]
}
