    },
    { "id": "receive-resends", "from": "receive", "to": "resend" },
    {
      "id": "client-sends-retry",
      "from": "resend",
      "to": "client-send",
      "route": "right-channel",
      "fromSide": "right",
      "toSide": "right"
    }
  ],
  "cards": [
    {
      "dot": "slate",
      "title": "合約邊界",
      "items": [
        "RivetHTTPClient 僅宣告通用 AuthFlow 合約；HTTPClient 不驅動 AuthFlow",
        "用戶端僅依 ClientAction 執行請求與交付回應；不解讀或驅動 AuthFlow",
        ".send 攜帶既有不可變 HTTPRequest；.finish 是不攜帶資料的終止動作",
        "不包含執行期重送策略／實作、憑證、剖析器或 GitHub 特定行為"
      ]
    }
  ]
