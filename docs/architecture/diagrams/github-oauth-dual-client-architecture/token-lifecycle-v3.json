    { "id": "returns-response", "from": "response", "to": "complete" },
    { "id": "reports-401", "from": "response", "to": "refresh", "route": "drop", "variant": "security" },
    { "id": "returns-current", "from": "refresh", "to": "retry", "route": "right-channel", "variant": "emphasis" },
    { "id": "retry-once", "from": "retry", "to": "response", "route": "top-channel", "variant": "emphasis" },
    { "id": "refresh-permanent-failure", "from": "refresh", "to": "reauth", "route": "left-channel", "variant": "security" },
    { "id": "pre-rotation-technical-failure", "from": "refresh", "to": "technical-failure", "route": "top-channel", "variant": "default" },
    { "id": "second-401", "from": "retry", "to": "reauth", "route": "bottom-channel", "variant": "security" }
