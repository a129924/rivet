{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "GitHub OAuth 雙 Client 的 401 復原生命週期",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      650
    ],
    "views": [
      {
        "id": "main",
        "label": "原工作",
        "focus": [
          "query",
          "snapshot",
          "dispatch",
          "response",
          "complete"
        ],
        "note": "internal REST GET 與 GraphQL Query 已交付；跨 target 入口及產品登入仍延後。"
      },
      {
        "id": "recovery",
        "label": "401 復原",
        "focus": [
          "response",
          "refresh",
          "retry"
        ],
        "note": "client 回報實際使用的 TokenSnapshot；以新版快照重送各自原工作一次。"
      },
      {
        "id": "failure",
        "label": "失敗分類",
        "focus": [
          "refresh",
          "retryable",
          "reauth",
          "unknown",
          "persist"
        ],
        "note": "可信憑證拒絕需重新授權；技術失敗保留階段。取消 caller 不取消共享更新。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "用戶端原工作"
    },
    {
      "id": "recovery",
      "label": "提供者與一次復原"
    },
    {
      "id": "terminal",
      "label": "輪替狀態與停止"
    }
  ],
  "states": [
    {
      "id": "query",
      "type": "start",
      "label": "呼叫 GET 或 Query",
      "sublabel": "跨 target 延後",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "snapshot",
      "type": "active",
      "label": "取得有效快照",
      "sublabel": "過期先更新並保存",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "dispatch",
      "type": "active",
      "label": "加入 Bearer 送出",
      "sublabel": "保有原 GET／Query",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "response",
      "type": "decision",
      "label": "是否收到 401？",
      "sublabel": "403 不觸發更新",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "complete",
      "type": "success",
      "label": "交付回應",
      "sublabel": "非 401 原樣交付",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "refresh",
      "type": "active",
      "label": "取得新版快照",
      "sublabel": "實際版本／單飛更新",
      "lane": "recovery",
      "col": 1
    },
    {
      "id": "retry",
      "type": "decision",
      "label": "原工作重送一次",
      "sublabel": "取消不重送",
      "lane": "recovery",
      "col": 2,
      "width": 108
    },
    {
      "id": "retryable",
      "type": "failure",
      "label": "可再次更新",
      "sublabel": "明確未輪替／過期耗盡",
      "lane": "recovery",
      "col": 0,
      "yOffset": -80
    },
    {
      "id": "reauth",
      "type": "failure",
      "label": "需要重新授權",
      "sublabel": "憑證失效／第二次 401",
      "lane": "recovery",
      "col": 0,
      "yOffset": 70
    },
    {
      "id": "persist",
      "type": "failure",
      "label": "落盤失敗停止",
      "sublabel": "遠端輪替已接受",
      "lane": "terminal",
      "col": 2
    },
    {
      "id": "unknown",
      "type": "failure",
      "label": "輪替未知停止",
      "sublabel": "技術失敗；保留儲存",
      "lane": "terminal",
      "col": 1
    },
    {
      "id": "cancelled",
      "type": "failure",
      "label": "呼叫者取消",
      "sublabel": "停止復原與重送",
      "lane": "terminal",
      "col": 0
    }
  ],
