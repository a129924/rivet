  "cards": [
    {
      "dot": "cyan",
      "title": "GET 安全邊界與一次復原",
      "items": [
        "僅對 api.github.com 加入 Bearer；轉址不跟隨",
        "REST 與 GraphQL 共用 provider；各自原工作最多重送一次",
        "取消 caller 不取消 shared refresh"
      ]
    }
  ]
