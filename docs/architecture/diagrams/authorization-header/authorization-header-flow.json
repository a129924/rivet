  "cards": [
    {
      "dot": "emerald",
      "title": "唯一格式規則",
      "items": [
        "bearerValue 驗證並回傳字串；applyingBearer 重用同一實作。"
      ]
    },
    {
      "dot": "cyan",
      "title": "限定替換",
      "items": [
        "只匹配 ASCII 大小寫變體；不改 Token、其他鍵值或原始輸入。"
      ]
    },
    {
      "dot": "slate",
      "title": "使用界線",
      "items": [
        "無網路或認證狀態；既有 consumers 尚未整合。Viewer UI／HTML lang 使用 English fallback。"
      ]
    }
