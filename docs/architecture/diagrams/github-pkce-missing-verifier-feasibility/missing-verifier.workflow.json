      "width": 92
    },
    {
      "id": "human-consent",
      "lane": "bounded",
      "col": 2,
      "type": "security",
      "label": "真人授權",
      "sublabel": "另准真人與原文",
      "width": 92
    },
    {
      "id": "single-exchange",
      "lane": "bounded",
