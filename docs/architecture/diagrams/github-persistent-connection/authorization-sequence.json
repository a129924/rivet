  "cards": [
    {
      "dot": "rose",
      "title": "失敗不建立可用連線",
      "items": [
        "取消／拒絕／錯誤 callback 不保存憑證",
        "先保存設定；授權失敗保留原資料",
        "所有出口關閉 relay／session"
      ]
    },
    {
      "dot": "cyan",
      "title": "責任維持",
      "items": [
        "Session 驗證 exact URL、state 與單次 code",
        "只索取 offline_access；secret 不入授權網址",
        "Presentation 只接 display-ready input／intent"
      ]
    }
  ]
