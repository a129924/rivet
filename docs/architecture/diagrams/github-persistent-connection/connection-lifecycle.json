{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "連線生命週期：同 provider 重試與重新授權",
    "quality_profile": "showcase",
    "viewBox": [
      1100,
      680
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "正常連線與新授權"
    },
    {
      "id": "retry",
      "label": "暫時失敗"
    },
    {
      "id": "terminal",
      "label": "舊 provider 停止"
    }
  ],
  "states": [
    {
      "id": "restore",
      "type": "start",
      "label": "載入與核對",
      "lane": "main",
      "col": 0
    },
    {
      "id": "prepare",
      "type": "active",
      "label": "連線工作",
      "lane": "main",
      "col": 2
    },
    {
      "id": "ready",
      "type": "success",
      "label": "帳號就緒",
      "lane": "main",
      "col": 4
    },
    {
      "id": "temporary",
      "type": "failure",
      "label": "暫時技術失敗",
      "lane": "retry",
      "col": 0
    },
    {
      "id": "reauth",
      "type": "waiting",
      "label": "退休後重授權",
      "lane": "retry",
      "col": 2
    },
    {
      "id": "stopped",
      "type": "failure",
      "label": "舊 provider 停止",
      "lane": "terminal",
      "col": 1
    }
  ],
  "transitions": [
    {
      "id": "restore-prepare",
      "from": "restore",
      "to": "prepare",
      "label": "同 ID 還原"
    },
    {
      "id": "prepare-ready",
      "from": "prepare",
      "to": "ready",
      "label": "有效帳號",
      "variant": "emphasis",
      "route": "straight",
      "labelAt": [
        600,
        112
      ]
    },
    {
      "id": "ready-reauth",
      "from": "ready",
      "to": "reauth",
      "label": "settled 後先退休",
      "variant": "security",
      "labelAt": [
        710,
        224
      ]
    },
    {
      "id": "new-grant",
      "from": "reauth",
      "to": "prepare",
      "label": "新 bundle 保存成功",
      "variant": "emphasis"
    },
    {
      "id": "temporary-failure",
      "from": "prepare",
      "to": "temporary"
    },
    {
      "id": "explicit-retry",
      "from": "temporary",
      "to": "prepare",
      "label": "同 provider 重試",
      "variant": "emphasis",
      "labelAt": [
        340,
        230
      ]
    },
    {
      "id": "rotation-stop",
      "from": "prepare",
      "to": "stopped",
      "label": "失效／輪替未知／保存失敗",
      "variant": "security",
      "labelAt": [
        530,
        390
      ]
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Settlement 才可改寫",
      "items": [
        "UI 取消不代表 Task 已 settled",
        "忙碌時新設定／重授權回 operationInProgress",
        "不排第二 session，完成後由使用者再觸發"
      ]
    },
    {
      "dot": "rose",
      "title": "舊 provider 不復活",
      "items": [
        "stopped／authenticationRequired 需重新授權",
        "重授權與修復都先退休原 provider／scope",
        "取消／grant／保存失敗不恢復原 provider"
      ]
    }
  ]
}
