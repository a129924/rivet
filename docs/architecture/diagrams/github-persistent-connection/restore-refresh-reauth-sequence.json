    },
    {
      "id": "m13",
      "from": "provider",
      "to": "product",
      "y": 636,
      "label": "實際 Task.value 完成",
      "variant": "return"
    },
    {
      "id": "m14",
      "from": "product",
      "to": "provider",
      "y": 674,
      "label": "settled 後退休舊 provider／scope",
      "variant": "security"
    },
    {
      "id": "m15",
      "from": "product",
      "to": "store",
      "y": 712,
      "label": "新 grant 完整保存後才可新建",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "停止與明確重試",
      "items": [
        "暫時 prepare 失敗：同 provider 明確重試",
        "rotation 未知／accepted save 失敗：停止",
        "停止後不藉重建 provider 恢復舊憑證"
      ]
    },
    {
      "dot": "violet",
      "title": "原 client policy 保留",
      "items": [
        "每次 execution 取 fresh snapshot",
        "只有 HTTP 401 可 recovery，原工作最多重送一次",
        "重授權取消／失敗不復活已退休 provider"
      ]
    }
  ]
}
