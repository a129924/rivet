  "cards": [
    {
      "dot": "amber",
      "title": "取消與提交",
      "items": [
        "預先取消不開始工作；執行中取消傳給原 worker",
        "等待原工作與通道收尾；最後同步檢查後不再 await",
        "保存完成後仍可能 cancelled，保留副作用、不回滾"
      ]
    },
    {
      "dot": "cyan",
      "title": "隔離與結果",
      "items": [
        "共享任一保存目的地，所有 service 共用同一協調器",
        "重疊登入直接拒絕；不涵蓋其他程序或背景 provider",
        "OAuth／PAT 分開保留；成功不交付帳號或 session"
      ]
    }
  ]
}
