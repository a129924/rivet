{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "E001：OAuth 重導向驗證",
    "quality_profile": "showcase",
    "animation": "none",
    "column_fit": "spread",
    "viewBox": [
      1000,
      1060
    ]
  },
  "participants": [
    {
      "id": "probe",
      "type": "backend",
      "label": "驗證程式",
      "sublabel": "loopback listener"
    },
    {
      "id": "listener",
      "type": "backend",
      "label": "本機 listener",
      "sublabel": "127.0.0.1"
    },
    {
      "id": "browser",
      "type": "frontend",
      "label": "系統瀏覽器"
    },
    {
      "id": "github",
      "type": "external",
      "label": "GitHub",
      "sublabel": "OAuth App"
    }
  ],
  "messages": [
    {
      "id": "bind",
      "from": "probe",
      "to": "listener",
      "y": 180,
      "label": "綁定 loopback 動態 port"
    },
    {
      "id": "ready",
      "from": "listener",
      "to": "probe",
      "y": 270,
      "label": "listener 就緒；產生 state",
      "variant": "security"
    },
    {
      "id": "open",
      "from": "probe",
      "to": "browser",
      "y": 370,
      "label": "開啟授權 URL"
    },
    {
      "id": "authorize",
      "from": "browser",
      "to": "github",
      "y": 470,
      "label": "登入並同意授權",
      "variant": "emphasis"
    },
    {
      "id": "redirect",
      "from": "github",
      "to": "browser",
      "y": 570,
      "label": "重導向至 loopback callback",
      "variant": "return"
    },
    {
      "id": "callback",
      "from": "browser",
      "to": "listener",
      "y": 670,
      "label": "GET /oauth/callback：code、state",
      "variant": "security"
    },
    {
      "id": "validate",
      "from": "listener",
      "to": "probe",
      "y": 770,
      "label": "判定 code 非空、state 相符",
      "variant": "security"
    },
    {
      "id": "cleanup",
      "from": "probe",
      "to": "listener",
      "y": 870,
      "label": "終結一次；清理資源"
    },
    {
      "id": "result",
      "from": "listener",
      "to": "browser",
      "y": 970,
      "label": "安全結果頁",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "成功條件",
      "items": [
        "真實 GitHub 授權返回、code 非空且 state 相符。"
      ]
    },
    {
      "dot": "amber",
      "title": "目前驗證狀態",
      "items": [
        "真實授權尚未執行；本機測試不能代替實測。"
      ]
    }
  ]
}
