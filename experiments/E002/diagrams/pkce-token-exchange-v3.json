    },
    {
      "id": "open-negative",
      "from": "runner",
      "to": "browser",
      "y": 420,
      "label": "新 state、S256 challenge；重新授權",
      "variant": "default"
    },
    {
      "id": "consent-negative",
      "from": "browser",
      "to": "github",
      "y": 450,
      "label": "第二次人工授權",
      "variant": "default"
    },
    {
      "id": "callback-negative",
      "from": "github",
      "to": "runner",
      "y": 480,
      "label": "新 code 的 loopback callback；驗證 state",
      "variant": "return"
    },
    {
      "id": "exchange-negative",
      "from": "runner",
      "to": "github",
      "y": 510,
      "label": "POST 新 code、錯誤 verifier、相同 secret",
      "variant": "default"
    },
    {
      "id": "reject-negative",
      "from": "github",
      "to": "runner",
      "y": 540,
      "label": "拒絕與受控歸因；任何 token 則失敗",
      "variant": "return"
    }
  ]
