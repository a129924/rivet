    },
    {
      "id": "token-positive",
      "from": "github",
      "to": "runner",
      "y": 300,
      "label": "回應：六欄 schema → public bundle",
      "variant": "return"
    },
    {
      "id": "user-request",
      "from": "runner",
      "to": "github",
      "y": 330,
      "label": "GET /user（僅一次）",
      "variant": "default"
    },
    {
      "id": "user-result",
      "from": "github",
      "to": "runner",
      "y": 360,
