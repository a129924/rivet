    },
    {
      "id": "github",
      "type": "external",
      "label": "GitHub.com",
      "sublabel": "OAuth App 與 API"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 385,
      "label": "正向：交換、schema、API 分軸"
    },
    {
      "from": 400,
      "to": 565,
      "label": "反向：僅交換成功且無網路阻礙才進入"
    }
  ],
  "messages": [
    {
      "id": "open-positive",
      "from": "runner",
      "to": "browser",
      "y": 180,
      "label": "開啟新授權：S256、state、offline_access",
      "variant": "default"
    },
    {
      "id": "consent-positive",
      "from": "browser",
      "to": "github",
      "y": 210,
